  "radio_test": {
    "_note": "Penalties for graphemes a listener cannot map to spelling reliably.",
    "penalties": [
      { "pattern": "x", "cost": 14, "reason": "heard as 'ks' or 'z' — spelling ambiguous" },
      { "pattern": "z", "cost": 10, "reason": "commonly misheard as 's'" },
      { "pattern": "q(?!u)", "cost": 22, "reason": "q without u has no stable English mapping" },
      { "pattern": "ph", "cost": 12, "reason": "competes with 'f'" },
      { "pattern": "kn|wr|gn|ps", "cost": 14, "reason": "silent-letter onset" },
      { "pattern": "y[aeiou]", "cost": 8, "reason": "y-as-consonant is unstable" },
      { "pattern": "[bcdfghjklmnpqrstvwxz]{4,}", "cost": 20, "reason": "unpronounceable cluster" },
      { "pattern": "(.)\\1", "cost": 7, "reason": "doubled letter — single/double ambiguity" },
      { "pattern": "^[aeiou]{2}", "cost": 10, "reason": "vowel-pair onset is hard to place" },
      { "pattern": "ae|oe", "cost": 8, "reason": "digraph spelling is guessed wrong" },
      { "pattern": "c[eiy]", "cost": 6, "reason": "soft-c competes with 's'" }
    ]
  },

  "scoring_weights": {
    "radio_test": 0.32,
    "length_band": 0.18,
    "syllables": 0.16,
    "semantic_evocation": 0.20,
    "buyer_breadth": 0.14
