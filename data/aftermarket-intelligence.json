{
  "_README": "Resale-oriented naming model. Optimises for what actually clears in the brandable aftermarket (HugeDomains / BrandBucket / Squadhelp / Atom) rather than for hand-registration availability. Price bands are HEURISTIC MODELS of public marketplace ASKING ranges, not observed sale comps.",
  "version": "1.1",

  "max_length": 11,
  "_max_length_note": "Hard cap on generated names. 12+ characters reads long in the brandable market and hurts recall; 86% of the compound bank fits under this, and the latinate/dictionary banks always do.",


  "principles": [
    "Radio test dominates: a buyer must spell it correctly after hearing it once.",
    "Real morphemes beat invented phonetics — meaning widens the buyer pool.",
    "Two syllables and 5-9 characters is the premium band.",
    "Breadth of plausible buyer industries is a price multiplier.",
    "x/z/q-heavy invented strings read as dated and sell thin."
  ],

  "archetypes": {
    "compound": {
      "weight": 0.52,
      "label": "Compound",
      "note": "Two real English words. The dominant HugeDomains inventory shape.",
      "value_ceiling": 92,
      "value_floor": 68,
      "hand_reg_odds": 34,
      "route": "Often still hand-registrable — the core reseller play",
      "resale_ceiling": 95
    },
    "latinate": {
      "weight": 0.31,
      "label": "Latinate",
      "note": "Latin/Greek root plus a clean vowel ending. The BrandBucket shape.",
      "value_ceiling": 86,
      "value_floor": 62,
      "hand_reg_odds": 62,
      "route": "Usually available to register — coined but meaningful",
      "resale_ceiling": 92
    },
    "dictionary": {
      "weight": 0.14,
      "label": "Dictionary",
      "note": "A single evocative real word. Highest value, effectively zero .com availability.",
      "value_ceiling": 100,
      "value_floor": 84,
      "hand_reg_odds": 3,
      "route": "The .com is long gone — aftermarket purchase or alternate TLD only",
      "resale_ceiling": 100
    },
    "coined": {
      "weight": 0,
      "generate": false,
      "label": "Coined",
      "note": "Classification bucket for model output that matches no resale archetype. Not generated locally — word-plus-nonsense-tail names (Anchordo, Summitno) read as typos and do not clear.",
      "value_ceiling": 72,
      "value_floor": 44,
      "hand_reg_odds": 80,
      "route": "Likely free to register, but thin resale demand",
      "resale_ceiling": 80
    }
  },

  "acquisition_note": "Resellers profit on the SPREAD between acquisition cost and sale price. A $12k name you cannot buy is worth nothing; a $2k name you register for $10 is the trade. Flip score = brand value discounted by how obtainable the .com actually is.",

