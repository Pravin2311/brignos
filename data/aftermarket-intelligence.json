    { "pattern": "[0-9]", "reason": "digits collapse resale value" },
    { "pattern": "^(the|my|get|try|go)", "reason": "filler prefixes signal a leftover registration" },
    { "pattern": "(ify|ly|io|zy|xy)$", "reason": "saturated startup suffix — heavily discounted" },
